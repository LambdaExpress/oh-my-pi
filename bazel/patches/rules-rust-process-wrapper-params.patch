+fn expand_wrapper_param_files(argv: Vec<String>) -> Result<Vec<String>, OptionError> {
+    let mut expanded = Vec::with_capacity(argv.len());
+    let mut parsing_child_arguments = false;
+
+    for arg in argv {
+        if parsing_child_arguments {
+            expanded.push(arg);
+        } else if arg == "--" {
+            parsing_child_arguments = true;
+            expanded.push(arg);
+        } else if let Some(path) = arg.strip_prefix('@') {
+            expanded.extend(read_file_to_array(path).map_err(|err| {
+                OptionError::Generic(format!(
+                    "failed to read process wrapper parameter file {path}: {err}"
+                ))
+            })?);
+        } else {
+            expanded.push(arg);
+        }
+    }
+
+    Ok(expanded)
+}
