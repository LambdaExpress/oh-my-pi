{
	"$schema": "../gen/schemas/desktop-schema.json",
	"capabilities": [
		{
			"identifier": "default",
			"windows": ["main"],
			"permissions": [
				"core:default",
				"dialog:default",
				"allow-project-list",
				"allow-project-open",
				"allow-project-switch",
				"allow-app-info"
			]
		},
		{
			"identifier": "remote-project-commands",
			"local": false,
			"remote": {
				"urls": ["http://127.0.0.1:*"]
			},
			"windows": ["main"],
			"permissions": [
				"allow-project-list",
				"allow-project-open",
				"allow-project-switch",
				"allow-app-info"
			]
		}
	]
}
